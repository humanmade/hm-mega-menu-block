{
    "name": "humanmade/hm-mega-menu-block",
    "description": "A reusable Gutenberg block for creating mega menus in WordPress.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",

    "require": {
        "php": ">=8.2",
        "composer/installers": "^2.0"
    },
    "require-dev": {
        "humanmade/coding-standards": "^2.5"
    },
    "scripts": {
        "phpcs": "phpcs"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "autoload": {
        "psr-4": {
            "HumanMade\\MegaMenuBlock\\": "src/"
        }
    },
    "extra": {
        "wordpress-plugin": true
    },
    "minimum-stability": "stable"
}
